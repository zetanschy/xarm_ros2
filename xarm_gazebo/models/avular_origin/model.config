<?xml version="1.0"?>
<model>
  <name>avular_origin</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <description>
    Meshes del Avular Origin One, usados como robot movil en table_aruco.world
    (Tarea 2, Clase 5). Vienen de https://github.com/zetanschy/avular_origin_simulation
    (origin_one_description). Solo se usan como visual: el robot de la tarea se
    mueve con juntas prismaticas, no con las ruedas.

    No hay model.sdf util aca; este directorio existe para que las mallas se
    resuelvan como model://avular_origin/meshes/... desde el .world.
  </description>
</model>
