<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>xarm_hybrid_planning</name>
  <version>0.1.0</version>
  <description>
    Planner logic plugin para el ejemplo de hybrid planning del curso (Clase 5).
    Corrige dos limitaciones de moveit_hybrid_planning/ReplanInvalidatedTrajectory
    que impiden que el ciclo reactivo cierre.
  </description>
  <maintainer email="janssv.200604@gmail.com">zetans</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>moveit_hybrid_planning</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>
  <depend>moveit_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
